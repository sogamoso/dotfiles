#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/install/lib/log.sh"

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_heading "Installing Sebastian's dotfiles.."

# Cache sudo credentials upfront — some casks need them. The Linux path only
# stows configs and touches ~/.bashrc, so it never needs root.
if [[ "$(uname -s)" == "Darwin" ]]; then
  sudo true
  log_success "Granted"
  while true; do sudo -n true 2>/dev/null || true; sleep 30; kill -0 "$$" 2>/dev/null || exit; done &
  SUDO_LOOP_PID=$!
  trap 'kill "$SUDO_LOOP_PID" 2>/dev/null || true' EXIT
fi

# Work lives in ~/Work as on Omarchy, with ~/Work/tries for try
mkdir -p "$HOME/Work/tries"

# OS specific setup
case "$(uname -s)" in
  Darwin)
    bash "$REPO_DIR/install/macos/all.sh"
    ;;
  Linux)
    bash "$REPO_DIR/install/linux/all.sh"
    ;;
  *)
    log_warn "Unsupported OS"
    exit 1
    ;;
esac

# Personal dotfiles
bash "$REPO_DIR/install/dotfiles/all.sh"

# What's left to do. On a new Mac the manual steps still show as problems, so
# this only reports and never fails the install.
if [[ "$(uname -s)" == "Darwin" ]]; then
  log_heading "Checking the setup..."
  DOTFILES="$REPO_DIR" "$HOME/.local/bin/dotfiles" doctor ||
    log_warn "Some checks fail until the manual steps in docs/macos-manual-setup.md are done; rerun dotfiles doctor after them"
fi

log_heading "Finishing Sebastian's dotfiles installation..."
log_success "Done!"

case "$(uname -s)" in
  Darwin) exec zsh -l ;;
  *)      exec bash -l ;;
esac

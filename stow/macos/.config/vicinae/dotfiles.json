{
  "$schema": "https://vicinae.com/schemas/config.json",
  "global_shortcuts": {
    "toggle": "alt+space"
  },
  "close_on_focus_loss": true,
  "pop_to_root_on_close": true,
  "escape_key_behavior": "close_window",
  "tray": {
    "enabled": false
  },
  "theme": {
    "dark": {
      "name": "tokyo-night"
    }
  },
  "providers": {
    "@khasbilegt/store.raycast.1password": {
      "preferences": {
        "version": "v8",
        "primaryAction": "open-in-1password",
        "secondaryAction": "open-in-browser",
        "closeWindowAfterCopying": true,
        "reduceItemListMemoryUsage": false,
        "zshPath": "/bin/zsh",
        "cliPath": null
      },
      "entrypoints": {
        "renew-auth": {
          "enabled": true
        }
      }
    },
    "raycast-compat": {
      "entrypoints": {
        "store": {
          "preferences": {
            "alwaysShowIntro": false
          }
        }
      }
    },
    "@thomaslombart/store.raycast.linear": {
      "preferences": {
        "limit": "50",
        "labelsLimit": "100",
        "shouldHideRedundantIssues": false,
        "issueCustomCopyAction": null
      },
      "entrypoints": {
        "create-issue-for-myself": {
          "preferences": {
            "preferredTeamKey": "TECH",
            "shouldCloseMainWindow": false
          }
        }
      }
    },
    "@Aayush9029/store.raycast.cleanshotx": {
      "entrypoints": {
        "capture-area-raycast-aichat": {
          "enabled": false
        },
        "hide-desktop-icons": {
          "enabled": false
        },
        "manage-recording-presets": {
          "enabled": false
        },
        "open-settings": {
          "enabled": true
        },
        "show-desktop-icons": {
          "enabled": false
        },
        "toggle-desktop-icons": {
          "enabled": false
        },
        "view-uploads": {
          "enabled": true
        }
      }
    },
    "@HenriChabrand/store.raycast.notion": {
      "preferences": {
        "open_in": "com.google.Chrome",
        "properties_in_page_previews": true
      }
    },
    "@Rob/store.raycast.granola": {
      "preferences": {
        "notionMaxBatchSize": "20"
      }
    },
    "@abielzulio/store.raycast.chatgpt": {
      "preferences": {
        "useStream": true,
        "isAutoSaveConversation": true,
        "isHistoryPaused": false,
        "isAutoLoadText": false,
        "isAutoFullInput": true,
        "isAutoTTS": false,
        "useApiEndpoint": false,
        "useVisionModel": false,
        "useProxy": false,
        "proxyProtocol": "http",
        "useAzure": false
      },
      "enabled": false
    },
    "@benvp/store.raycast.audio-device": {
      "preferences": {
        "systemOutput": true,
        "favourite": "",
        "favourite2": ""
      }
    },
    "@florisdobber/store.raycast.claude": {
      "preferences": {
        "useStream": true,
        "isAutoLoad": true,
        "isAutoFullInput": true
      },
      "enabled": false
    },
    "@frouo/store.raycast.google-chrome-profiles": {
      "preferences": {
        "browser": "chrome",
        "newTabURL": "https://google.com/search?q=%query%",
        "sortProfiles": "name",
        "popToRootAfterOpen": false,
        "directSwitch": false,
        "focusWithoutNewWindow": true
      }
    },
    "@fuksman/store.raycast.calendar": {
      "enabled": true,
      "preferences": {
        "weekStart": "0",
        "showWeeks": true,
        "viewMode": "1"
      },
      "entrypoints": {
        "index": {
          "alias": "qc"
        }
      }
    },
    "@gebeto/store.raycast.translate": {
      "preferences": {
        "langFrom": "auto",
        "lang1": "en",
        "lang2": "es",
        "autoInput": true,
        "defaultAction": "copy",
        "prioritizeCrossLanguage": false
      }
    },
    "@josephschmitt/store.raycast.gif-search": {
      "preferences": {
        "gridItemSize": "medium",
        "gridTrendingItemSize": "medium",
        "maxResults": "20",
        "defaultAction": "copyFile",
        "hideFilename": false,
        "giphyLocale": "en",
        "klipyLocale": "en",
        "downloadPath": "/Users/sogamoso/Downloads"
      }
    },
    "@knoopx/store.vicinae.agenda": {
      "preferences": {
        "refreshInterval": "15",
        "timeFormat": "24h"
      }
    },
    "@limonkufu/store.raycast.aerospace": {
      "enabled": true,
      "preferences": {
        "showFullBindings": true,
        "showMenuBarExtras": true,
        "showWorkspaceName": true
      }
    },
    "@marcjulian/store.raycast.obsidian": {
      "enabled": false,
      "preferences": {
        "configFileName": ".obsidian"
      }
    },
    "@mattisssa/store.raycast.spotify-player": {
      "preferences": {
        "closeWindowOnAction": true
      },
      "entrypoints": {
        "cycleRepeat": {
          "enabled": true
        },
        "dislike": {
          "enabled": false
        },
        "like": {
          "enabled": true
        },
        "startDJ": {
          "enabled": true
        },
        "startRadio": {
          "enabled": true
        }
      }
    },
    "@mrpunkin/store.raycast.raycast-zoxide": {
      "preferences": {
        "search-mode": "fuzzy",
        "open-in": "com.apple.finder",
        "open-in-terminal": "com.mitchellh.ghostty",
        "open-in-editor": "com.sogamoso.neovim"
      }
    },
    "@nhojb/store.raycast.brew": {
      "preferences": {
        "terminalApp": "ghostty",
        "greedyUpgrades": true,
        "disableDownloadConcurrency": false,
        "pinnedFirst": true,
        "closeAfterAction": true,
        "verboseLogging": true
      }
    },
    "@thomas/store.raycast.downloads-manager": {
      "preferences": {
        "lastestDownloadOrder": "addTime",
        "deletionBehavior": "trash",
        "showDeletingFilename": true,
        "downloadsFolder": "/Users/sogamoso/Downloads"
      },
      "entrypoints": {
        "manage-downloads": {
          "preferences": {
            "primaryAction": "open",
            "showHiddenFiles": true,
            "showPreview": true,
            "fileOrder": "addTime",
            "downloadsLayout": "list"
          }
        }
      }
    },
    "@thomaslombart/store.raycast.github": {
      "preferences": {
        "defaultSearchTerms": "author:@me",
        "vscodeBuild": "vscode",
        "repositoryCloneProtocol": "ssh",
        "isOpenInBrowser": true,
        "includeTeamReviewRequests": true,
        "repositoryFilterMode": "all",
        "numberOfResults": null,
        "baseClonePath": null,
        "repositoryList": null
      }
    },
    "@vimtor/store.raycast.whatsapp": {
      "preferences": {
        "defaultCountry": "PA"
      }
    },
    "@vishaltelangre/store.raycast.google-drive": {
      "preferences": {
        "googleDriveRootPath": "~/Google Drive",
        "shouldShowHiddenFiles": true,
        "shouldShowDirectories": true,
        "excludePaths": "",
        "autoReindexingInterval": "604800000"
      },
      "enabled": false
    },
    "@vlades/store.raycast.herdr": {
      "preferences": {
        "sessionEnterAction": "attach",
        "terminalApplication": "com.mitchellh.ghostty",
        "refreshInterval": "5",
        "outputLines": "150",
        "terminalFocusBehavior": "open",
        "closeAfterPrompt": true,
        "showIdleInMenuBar": true
      },
      "entrypoints": {
        "open-herdr": {
          "alias": "herdr"
        }
      }
    },
    "clipboard": {
      "preferences": {
        "monitoring": true,
        "preserveTagged": true,
        "ignoredApps": [],
        "evictionThreshold": "604800",
        "eraseOnStartup": false
      }
    },
    "core": {
      "entrypoints": {
        "sponsor": {
          "enabled": false
        },
        "forget-telemetry": {
          "enabled": true
        },
        "inspect-local-storage": {
          "enabled": true
        },
        "oauth-token-store": {
          "enabled": true
        },
        "search-builtin-icons": {
          "enabled": true
        },
        "store": {
          "preferences": {
            "alwaysShowIntro": false
          }
        }
      }
    },
    "power": {
      "enabled": false
    },
    "system": {
      "entrypoints": {
        "browse-apps": {
          "enabled": true,
          "preferences": {
            "sortAlphabetically": true,
            "showHidden": true
          }
        }
      },
      "tools": {
        "bash": {
          "policy": "allow"
        },
        "open": {
          "policy": "allow"
        }
      }
    },
    "@joao.mainka/store.raycast.raycast-timezone-converter": {
      "preferences": {
        "sortTimezones": "alphabetically",
        "hideWorldMap": true
      }
    },
    "@koinzhang/store.raycast.copy-path": {
      "preferences": {
        "showCopyTip": true,
        "showLastCopy": true,
        "showTabTitle": false,
        "useTildeForHome": false,
        "multiPathSeparator": "\n",
        "copyUrlContent": "Original",
        "copyWhenUnSupported": "windowTitle"
      }
    },
    "@mommertf/store.raycast.slack": {
      "preferences": {
        "showAiMessageSignature": false,
        "closeRightSidebar": true
      }
    },
    "@tonka3000/store.raycast.gmail": {
      "preferences": {
        "clientid": ""
      },
      "enabled": false
    },
    "manage-shortcuts": {
      "enabled": false,
      "entrypoints": {
        "create": {
          "enabled": true
        }
      }
    },
    "theme": {
      "enabled": false
    },
    "wm": {
      "enabled": false,
      "entrypoints": {
        "switch-windows": {
          "enabled": true
        }
      }
    },
    "applications": {
      "entrypoints": {
        "com.sogamoso.neovim": {
          "alias": "neovim,nvim,vim"
        },
        "dev.zed.Zed": {
          "alias": "zed"
        },
        "com.anysphere.sand": {
          "alias": "bot,gork bot"
        },
        "com.google.Chrome.app.ggjocahimgaohmigbfhghnlfcnjemagj": {
          "alias": "gork"
        },
        "com.anthropic.claudefordesktop": {
          "alias": "cx"
        },
        "com.openai.codex": {
          "alias": "cy"
        },
        "net.whatsapp.WhatsApp": {
          "alias": "wa"
        },
        "so.sogamo.gmail-mailto": {
          "alias": "mail"
        }
      }
    },
    "@leonkohli/store.vicinae.process-manager": {
      "preferences": {
        "refresh-interval": "5000",
        "sort-by-memory": false,
        "show-system-processes": false,
        "show-pid": true,
        "show-path": true,
        "search-in-paths": true,
        "search-in-pid": true,
        "close-window-after-kill": false,
        "clear-search-after-kill": false,
        "process-limit": "500"
      }
    },
    "ai": {
      "preferences": {
        "providers": {
          "claude-code": {
            "type": "claude-code",
            "fields": {}
          },
          "codex": {
            "type": "codex",
            "fields": {}
          },
          "local": {
            "type": "local",
            "fields": {
              "keepLoaded": "900"
            }
          }
        },
        "defaultModel": "claude-code:opus",
        "instructions": "",
        "enableTools": true
      }
    },
    "apple-shortcuts": {
      "entrypoints": {
        "35C571B8-95AA-43B3-A28B-EF4B79F538FC": {
          "enabled": false
        }
      }
    },
    "dictation": {
      "enabled": false,
      "entrypoints": {
        "vocab": {
          "enabled": false
        }
      }
    },
    "files": {
      "tools": {
        "read": {
          "policy": "allow"
        }
      }
    },
    "browser-extension": {
      "enabled": false
    },
    "screenshots": {
      "enabled": false
    },
    "@samlinville/store.raycast.tailscale": {
      "preferences": {
        "tailscalePath": "/opt/homebrew/bin/tailscale"
      }
    }
  },
  "wrap_navigation": true,
  "font": {
    "normal": {
      "family": ".AppleSystemUIFont"
    }
  },
  "fallbacks": [
    "ai:quick",
    "@mblode/store.raycast.google-search:index",
    "files:search"
  ]
}

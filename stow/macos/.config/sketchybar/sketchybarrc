#!/usr/bin/env bash

FONT="JetBrainsMono Nerd Font"

export CONFIG_DIR="$HOME/.config/sketchybar"
source "$CONFIG_DIR/lib/common.sh"
source "$CONFIG_DIR/lib/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
LAUNCH="$HOME/.config/aerospace/launch-or-focus.sh"

# Menu bar height helper builds to ~/.cache to avoid stow conflicts
MBHEIGHT_BIN="$CACHE_DIR/menu_bar_height"
build_swift "$PLUGIN_DIR/menu_bar_height.swift" "$MBHEIGHT_BIN"
BAR_HEIGHT=$("$MBHEIGHT_BIN" 2>/dev/null || echo 30)

# Sync AeroSpace outer.top gap with the bar height (no reload — reload() handles that).
# Side effect: compiles $CACHE_DIR/has_external_display, which we reuse below.
"$PLUGIN_DIR/sync_aerospace_gap.sh"
HAS_EXTERNAL=$("$CACHE_DIR/has_external_display" 2>/dev/null || echo 0)

# Bar
sketchybar --bar \
  height=$BAR_HEIGHT \
  position=top \
  topmost=off \
  padding_left=12 \
  padding_right=12 \
  color=$BG \
  border_width=0

# Stay hidden across reloads while the full screen desktop toggle is on
[[ -e ${TMPDIR:-/tmp}/dotfiles-fullscreen-desktop ]] && sketchybar --bar hidden=on

# Defaults
sketchybar --default \
  padding_left=6 \
  padding_right=6 \
  icon.font="$FONT:Bold:16.0" \
  label.font="$FONT:Regular:13.0" \
  icon.color=$TEXT \
  label.color=$TEXT

# Custom events
sketchybar --add event aerospace_workspace_change

# Launcher anchor — leftmost item (Omarchy parity: left = launcher, right = terminal)
sketchybar --add item apple_menu left \
  --set apple_menu \
    icon="" \
    label.drawing=off \
    padding_left=8 \
    padding_right=4 \
    click_script='case "$BUTTON" in
      right) open -na Ghostty ;;
      *)     vicinae vicinae://toggle ;;
    esac'

# Workspace indicators (1–9, 10 is scratchpad with no indicator)
# Styling handled dynamically in plugins/space.sh (Omarchy parity)
for i in {1..9}; do
  sketchybar --add item space.$i left \
    --set space.$i \
      icon=$i \
      icon.font="$FONT:Bold:13.0" \
      icon.padding_left=6 \
      icon.padding_right=6 \
      label.drawing=off \
      click_script="aerospace workspace $i && sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$i" \
      script="$PLUGIN_DIR/space.sh" \
    --subscribe space.$i aerospace_workspace_change mouse.scrolled
done

# Clock — centered when an external display is connected (Omarchy parity).
# On laptop-only, macOS auto-hides the system menu bar, taking the system clock
# with it; place ours at the rightmost of the right group so it sits where the
# system clock would have been. Position re-evaluates on display change because
# display_change.sh reloads sketchybar, which re-runs this whole file.
CLOCK_POSITION=right
(( HAS_EXTERNAL == 1 )) 2>/dev/null && CLOCK_POSITION=center
sketchybar --add item clock "$CLOCK_POSITION" \
  --set clock \
    update_freq=5 \
    icon.drawing=off \
    script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock mouse.clicked

# Battery (NOTE: system_woke event may not fire on all macOS versions)
sketchybar --add item battery right \
  --set battery \
    update_freq=120 \
    click_script="open 'x-apple.systempreferences:com.apple.preference.battery'" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change

# CPU
sketchybar --add item cpu right \
  --set cpu \
    icon.font="$FONT:Bold:19.0" \
    update_freq=5 \
    click_script="$PLUGIN_DIR/activity_monitor.sh" \
    script="$PLUGIN_DIR/cpu.sh"

# Volume
sketchybar --add item volume right \
  --set volume \
    icon.font="$FONT:Bold:21.0" \
    update_freq=5 \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change mouse.clicked mouse.scrolled

# Microphone — drawn only while muted; click toggles via the shared mic script
sketchybar --add item mic right \
  --set mic \
    icon="󰍭" \
    icon.color=$RED \
    icon.font="$FONT:Bold:17.0" \
    label.drawing=off \
    drawing=off \
    update_freq=5 \
    click_script="$HOME/.config/dotfiles/mic-mute.sh" \
    script="$PLUGIN_DIR/mic.sh"

# Stay awake — drawn while a caffeinate assertion is held (workhours or manual)
sketchybar --add item stay_awake right \
  --set stay_awake \
    icon="󰅶" \
    icon.color=$YELLOW \
    label.drawing=off \
    drawing=off \
    update_freq=30 \
    script="$PLUGIN_DIR/stay_awake.sh"

# Reminder — drawn while one is queued; reminder.sh triggers the event on
# set, clear and fire, so the poll only catches what it missed
sketchybar --add event dotfiles_reminder_change
sketchybar --add item reminder right \
  --set reminder \
    icon="󰂚" \
    label.padding_left=2 \
    drawing=off \
    update_freq=60 \
    script="$PLUGIN_DIR/reminder.sh" \
  --subscribe reminder dotfiles_reminder_change mouse.clicked

# WiFi (NOTE: wifi_change event is fragile - removed)
sketchybar --add item wifi right \
  --set wifi \
    update_freq=30 \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
    script="$PLUGIN_DIR/wifi.sh"

# Bluetooth
sketchybar --add item bluetooth right \
  --set bluetooth \
    icon.font="$FONT:Bold:17.0" \
    update_freq=10 \
    label.drawing=off \
    click_script="open 'x-apple.systempreferences:com.apple.preferences.Bluetooth'" \
    script="$PLUGIN_DIR/bluetooth.sh"

# Input source
sketchybar --add item input_source right \
  --set input_source \
    icon.drawing=off \
    label.font="$FONT:Bold:10.0" \
    label.color=$BG \
    label.padding_left=4 \
    label.padding_right=4 \
    background.color=$MUTED \
    background.corner_radius=3 \
    background.height=15 \
    background.drawing=on \
    padding_left=4 \
    padding_right=8 \
    update_freq=3 \
    click_script="$PLUGIN_DIR/switch_input_source.sh" \
    script="$PLUGIN_DIR/input_source.sh"

# Claude Code usage — spend in the active billing block, from local transcripts
sketchybar --add item claude_usage right \
  --set claude_usage \
    icon="󰚩" \
    icon.color=$BLUE \
    label.color=$BLUE \
    label.padding_left=2 \
    drawing=off \
    update_freq=300 \
    click_script="$LAUNCH --new Ghostty --args -e ccusage blocks" \
    script="$PLUGIN_DIR/claude_usage.sh"

# Dotfiles update indicator — visible only when local repo is behind origin
sketchybar --add item dotfiles_update right \
  --set dotfiles_update \
    icon="󰚰" \
    icon.color=$BLUE \
    label.color=$BLUE \
    label.padding_left=2 \
    drawing=off \
    update_freq=21600 \
    click_script="$LAUNCH --new Ghostty --args -e $HOME/.local/bin/dotfiles update" \
    script="$PLUGIN_DIR/dotfiles_update.sh"

# Display change watcher — reloads bar when displays are added/removed (NOTE: system_woke may not fire on all macOS)
sketchybar --add item display_watcher left \
  --set display_watcher \
    drawing=off \
    script="$PLUGIN_DIR/display_change.sh" \
  --subscribe display_watcher display_change display_added display_removed

sketchybar --update

# Rebuilding the bar emits its own display_change; stamping here lets
# display_change.sh debounce from the end of a rebuild rather than from the
# moment one was requested, so a slow config run cannot re-trigger itself.
touch "$RELOAD_STAMP"

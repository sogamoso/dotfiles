<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sogamoso.herdr-server</string>

  <!-- A login shell, so the server and its plugins get Homebrew and mise on PATH -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/.config/dotfiles/herdr-server.sh"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- `herdr server stop` gets a fresh server in this login session -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/com.sogamoso.herdr-server.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.sogamoso.herdr-server.err</string>
</dict>
</plist>

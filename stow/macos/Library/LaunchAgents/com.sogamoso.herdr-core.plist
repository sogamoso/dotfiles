<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sogamoso.herdr-core</string>

  <!-- herdr-core, which runs the Herdr app's terminals, for the Mac mini. Left
       to Herdr, the mini's core would start with the first connection from a
       laptop, inside that SSH login, and no terminal could reach the login
       keychain (the terminal herdr had the same problem, see herdr-server).
       A core started here, in the login session, is the one those connections
       find. hc starts it through a one-shot launchd job of its own and returns,
       so this runs once per login; a login shell puts hc on PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec hc server start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/com.sogamoso.herdr-core.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.sogamoso.herdr-core.err</string>
</dict>
</plist>

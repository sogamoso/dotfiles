<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sogamoso.agents-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/.config/dotfiles/agents-update.sh"</string>
  </array>

  <!-- Every four hours, as Omarchy's auto_update = "4h" -->
  <key>StartInterval</key>
  <integer>14400</integer>

  <key>StandardOutPath</key>
  <string>/tmp/com.sogamoso.agents-update.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.sogamoso.agents-update.err</string>
</dict>
</plist>

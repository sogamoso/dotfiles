#!/usr/bin/env bash
# dotfiles — convenience CLI for managing this dotfiles repo.
# Override the repo location via $DOTFILES (default: ~/Work/sogamoso/dotfiles).
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/Work/sogamoso/dotfiles}"
[[ -d $DOTFILES ]] || DOTFILES="$HOME/Code/sogamoso/dotfiles"  # a machine not yet moved to ~/Work

usage() {
  cat <<EOF
Usage: dotfiles <command>

Commands:
  update    Pull, sync Brewfile, restow, reload services, update mise tools
  pull      Git pull only
  brew      Sync Brewfile, keep brew autoupdate current
  stow      Re-stow all dotfile packages
  reload    Re-stow, relink skills, restart SketchyBar, reload AeroSpace
  status    Show repo state (branch, ahead/behind, dirty files)
  doctor    Check this Mac's setup: Tailscale, SSH, firewall, agents, skills
  vicinae [status | save | reset]
            Compare Vicinae's settings and extensions with the repo; save
            keeps what changed here, reset throws it away
  omarchy-downstream-candidates [--list | --mark-reviewed]
            Review Omarchy changes worth porting, in Claude Code (or Codex);
            --list prints the raw changes, --mark-reviewed records the review
  agent [<name> | run [--prompt <text>]]
            Show or set the default coding agent, like omarchy default agent;
            run launches it the way omarchy-agent does (the a alias)
  edit      Open the repo in \$VISUAL (defaults to nvim)
  help      Show this message
EOF
}

run() { echo "==> $*"; "$@"; }

cmd_pull() {
  # --autostash: tools write some stowed files themselves (Claude Code its
  # settings.json), and with pull.rebase on, git refuses to pull over them
  if run git -C "$DOTFILES" pull --ff-only --autostash; then
    return
  fi
  explain_pull_failure
  return 1
}

# `git pull --ff-only` prints the same "Not possible to fast-forward" whether you
# have local commits to push or upstream history was rewritten under you — and the
# fixes are opposites. Say which one it is and name the command that resolves it.
explain_pull_failure() {
  local upstream ahead
  upstream=$(git -C "$DOTFILES" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo "")

  if [[ -n $(git -C "$DOTFILES" status --porcelain) ]]; then
    echo "==> Uncommitted changes are in the way:"
    git -C "$DOTFILES" status --short | sed 's/^/    /'
    echo "    Commit or stash them, then: dotfiles pull"
    return
  fi

  if [[ -z $upstream ]]; then
    echo "==> No upstream is configured for this branch"
    echo "    Set one with: git -C $DOTFILES branch --set-upstream-to=origin/main"
    return
  fi

  if ! git -C "$DOTFILES" merge-base HEAD "$upstream" >/dev/null 2>&1; then
    echo "==> $upstream shares no history with this checkout — it was rewritten"
    echo "    Discard local history: git -C $DOTFILES reset --hard $upstream"
    echo "    Or re-clone the repo for a smaller .git"
    return
  fi

  ahead=$(git -C "$DOTFILES" rev-list --count "$upstream..HEAD")
  if (( ahead > 0 )); then
    echo "==> $ahead local commit(s) are not on $upstream"
    echo "    Rebase them on top: git -C $DOTFILES pull"
    echo "    Then publish them:  git -C $DOTFILES push"
    return
  fi

  echo "==> Branch is not ahead of $upstream — see the git error above"
  echo "    Usually network or SSH auth. Retry with: dotfiles pull"
}

cmd_brew() {
  local bundle_failed=0
  (source "$DOTFILES/install/lib/brew-trust.sh"; brew_trust_taps "$DOTFILES/Brewfile")
  # One cask failing (often one that needs sudo) shouldn't skip the firewall
  # and autoupdate steps below; report it at the end instead
  # Unattended (the daily agent), only install what's missing: upgrades are
  # brew autoupdate's job, and it can ask for a password in a window, which a
  # run with no terminal can't
  local bundle_args=(--file="$DOTFILES/Brewfile")
  [[ -n ${DOTFILES_UNATTENDED:-} ]] && bundle_args+=(--no-upgrade)
  run brew bundle install "${bundle_args[@]}" || bundle_failed=1
  (source "$DOTFILES/install/lib/brew-autoupdate.sh"; brew_autoupdate_ensure) ||
    echo "==> brew autoupdate start failed; continuing without daily autoupdate"
  # Allow upgraded tailscaled and mosh-server through the firewall and restart
  # a tailscaled left on its old binary; sudo only when something changed.
  # The daemon then does the same after background upgrades.
  run "$HOME/.config/dotfiles/firewall.sh"
  run "$HOME/.config/dotfiles/firewall.sh" --install
  if (( bundle_failed )); then
    echo "==> brew bundle failed for some Brewfile entries; see its output above"
    return 1
  fi
}

cmd_stow() {
  run "$DOTFILES/install/dotfiles/stow.sh"
}

cmd_reload() {
  cmd_stow
  # Git filters live in .git/config, which no pull updates, so a changed filter
  # would otherwise only reach this checkout on the next bootstrap. Both scripts
  # just run `git config`, so rerunning them is instant and idempotent.
  local filter
  for filter in aerospace-gap coderabbit; do
    run "$DOTFILES/install/dotfiles/$filter.sh"
  done
  # Skills are linked, not stowed, so restowing doesn't pick up a new one, a
  # renamed category, or a dropped one. Cheap when nothing changed.
  local skills="$DOTFILES/install/dotfiles/skills.sh"
  [[ -x $skills ]] && run "$skills"
  if command -v sketchybar >/dev/null 2>&1; then
    # Clear the markers that stop sketchybarrc retrying Swift helper builds, so
    # a repaired toolchain gets picked up here rather than staying failed.
    rm -f "$HOME"/.cache/sketchybar/*.failed
    run sketchybar --reload
  fi
  if command -v aerospace >/dev/null 2>&1; then
    local gap_sync="$HOME/.config/sketchybar/plugins/sync_aerospace_gap.sh"
    [[ -x $gap_sync ]] && run "$gap_sync"
    run aerospace reload-config
  fi
  # herdr's server keeps running the old binary after an upgrade, which leaves
  # the CLI failing with protocol_mismatch until the service is restarted.
  # Restarting exits pane processes, so only do it once that has actually
  # happened rather than on every reload.
  if command -v herdr >/dev/null 2>&1; then
    if herdr tab list 2>&1 | grep -q protocol_mismatch; then
      run brew services restart herdr
    fi
  fi
  if [[ "$(uname -s)" == "Darwin" && -x "$DOTFILES/install/macos/neovim.sh" ]]; then
    run "$DOTFILES/install/macos/neovim.sh"
  fi
}

cmd_update() {
  cmd_pull
  # Moves ~/Code to ~/Work on a machine that hasn't moved yet; from then on the
  # repo is used at its new path, so stow links point there
  run bash "$DOTFILES/install/dotfiles/work-dir.sh"
  DOTFILES=$(cd -P "$DOTFILES" && pwd)
  # A cask that needs sudo fails brew without a terminal, as in the daily
  # agent's run; the restow and reloads still apply, and the failure is
  # reported at the end
  local brew_failed=0
  cmd_brew || brew_failed=1
  cmd_reload
  # Picks up extensions added on the other Mac; settings arrive through the stow
  run python3 "$DOTFILES/install/lib/vicinae.py" install || true
  # Every installed mise tool, as omarchy update does: an update is a request
  # for current versions, so mise's cooldown on new releases is skipped, the
  # same call the mup alias makes. Tools never run stay uninstalled.
  local mise_failed=0
  MISE_MINIMUM_RELEASE_AGE=0 run mise up || mise_failed=1
  if (( brew_failed )); then
    echo "==> Homebrew step failed; run dotfiles brew in a terminal to finish it"
    return 1
  fi
  if (( mise_failed )); then
    echo "==> mise up failed; see its output above"
    return 1
  fi
}

cmd_status() {
  cd "$DOTFILES"
  echo "==> Repo: $DOTFILES"
  echo "==> Branch: $(git rev-parse --abbrev-ref HEAD)"
  git fetch --quiet origin 2>/dev/null || true
  local upstream ahead behind
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo "")
  if [[ -n $upstream ]]; then
    ahead=$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo "?")
    behind=$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo "?")
    echo "==> Vs $upstream: $ahead ahead, $behind behind"
  fi
  # A clean filter's command lives in .git/config, which is never cloned, so a
  # machine that hasn't bootstrapped shows filtered files as dirty for no
  # visible reason. Name the missing ones instead.
  local missing=()
  while IFS= read -r name; do
    git config --get "filter.$name.clean" >/dev/null || missing+=("$name")
  done < <(sed -n 's/.*filter=\([A-Za-z0-9_-]*\).*/\1/p' .gitattributes | sort -u)
  if (( ${#missing[@]} )); then
    echo "==> Missing git filters: ${missing[*]}"
    echo "    Run dotfiles reload to configure them"
  fi

  # Links from a previous checkout location survive a move and silently stop
  # working — see install/lib/stow-orphans.sh. Naming them beats hunting for a
  # config that stopped applying for no visible reason.
  local orphans
  orphans=$(source "$DOTFILES/install/lib/stow-orphans.sh"; stow_orphans "$DOTFILES/stow" | wc -l | tr -d ' ')
  if (( orphans > 0 )); then
    echo "==> Orphaned symlinks: $orphans"
    echo "    Run dotfiles stow to clear them"
  fi

  echo "==> Working tree:"
  git status --short
}

# Things that broke silently before: Tailscale signed out, Remote Login on,
# mosh-server blocked after an upgrade, the work-hours agents loaded on the Mac
# mini, sleep-if-idle crashing on every run. Each check names its fix, and the
# exit status says whether anything failed.
TAILSCALE_LOGIN="sebastian@sogamo.so"
DOCTOR_FAILED=0

ok() { echo "  ✓ $1"; }
bad() {
  echo "  ✗ $1"
  [[ -n ${2:-} ]] && echo "    → $2"
  DOCTOR_FAILED=1
}

# Last exit code of a loaded agent, or nothing when it isn't loaded
agent_last_exit() {
  launchctl print "gui/$(id -u)/$1" 2>/dev/null |
    awk -F' = ' '/last exit code = / && !seen {print $2; seen=1}'
}

doctor_agent_loaded() {
  local label=$1 any_exit=${2:-} code
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    bad "$label is not loaded" "launchctl bootstrap gui/$(id -u) $plist"
    return
  fi
  code=$(agent_last_exit "$label")
  if [[ -n $any_exit || -z $code || $code == "0" || $code == "(never exited)" ]]; then
    ok "$label loaded${code:+, last exit $code}"
  else
    bad "$label last exited with $code" "See /tmp/$label.err and /tmp/$label.out"
  fi
}

doctor_agent_disabled() {
  local label=$1
  if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    bad "$label is loaded but shouldn't run on this Mac" \
      "launchctl bootout gui/$(id -u)/$label && launchctl disable gui/$(id -u)/$label"
  elif [[ "$(launchctl print-disabled "gui/$(id -u)")" != *"\"$label\" => disabled"* ]]; then
    bad "$label isn't disabled, so it loads at the next login" "launchctl disable gui/$(id -u)/$label"
  else
    ok "$label disabled"
  fi
}

cmd_doctor() {
  local model desktop=0
  model=$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Model Name/ {print $2}')
  [[ $model == *"Mac mini"* ]] && desktop=1
  echo "==> $model ($( (( desktop )) && echo "desktop" || echo "laptop"))"

  echo "==> Tailscale"
  if ! command -v tailscale >/dev/null 2>&1; then
    bad "tailscale isn't installed" "dotfiles brew"
  else
    local state login run_ssh
    state=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // empty')
    login=$(tailscale status --json 2>/dev/null | jq -r '.User[(.Self.UserID|tostring)].LoginName // empty')
    run_ssh=$(tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false')
    if [[ $state != "Running" ]]; then
      bad "Not connected (${state:-daemon not responding})" "tailscale up --ssh"
    elif [[ $login != "$TAILSCALE_LOGIN" ]]; then
      bad "Signed in as $login, not $TAILSCALE_LOGIN; SSH from the other devices won't be allowed" \
        "tailscale logout && tailscale up --ssh"
    else
      ok "Connected as $login"
    fi
    if [[ $run_ssh == "true" ]]; then ok "Tailscale SSH on"; else bad "Tailscale SSH off" "tailscale set --ssh"; fi
  fi

  echo "==> SSH"
  if launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
    bad "Remote Login (macOS sshd) is on" "sudo launchctl unload -w /System/Library/LaunchDaemons/ssh.plist"
  else
    ok "Remote Login off"
  fi
  if nc -z -G 1 127.0.0.1 22 >/dev/null 2>&1; then
    bad "Something listens on port 22" "sudo lsof -nP -iTCP:22 -sTCP:LISTEN"
  else
    ok "Nothing listens on port 22"
  fi

  echo "==> Firewall"
  if [[ "$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate)" == *enabled* ]]; then
    ok "Firewall on"
  else
    bad "Firewall off" "sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on"
  fi
  local fw sync_code
  if fw=$("$HOME/.config/dotfiles/firewall.sh" --check --quiet 2>&1); then ok "$fw"; else bad "$fw" "dotfiles brew"; fi
  # The root daemon that re-allows them after brew autoupdate upgrades
  if ! launchctl print system/com.sogamoso.firewall-sync >/dev/null 2>&1; then
    bad "Firewall sync daemon isn't loaded" "dotfiles brew"
  elif ! cmp -s "$(readlink -f "$HOME/.config/dotfiles/firewall.sh")" /usr/local/libexec/dotfiles/firewall.sh; then
    bad "Firewall sync daemon runs an outdated copy of firewall.sh" "dotfiles brew"
  else
    sync_code=$(launchctl print system/com.sogamoso.firewall-sync 2>/dev/null |
      awk -F' = ' '/last exit code = / && !seen {print $2; seen=1}')
    if [[ -z $sync_code || $sync_code == "0" || $sync_code == "(never exited)" ]]; then
      ok "Firewall sync daemon loaded${sync_code:+, last exit $sync_code}"
    else
      bad "Firewall sync daemon last exited with $sync_code" "See /var/log/com.sogamoso.firewall-sync.log"
    fi
  fi

  echo "==> Agents"
  doctor_agent_loaded com.sogamoso.keyboard.remap
  doctor_agent_loaded com.sogamoso.firewall-check
  doctor_agent_loaded com.sogamoso.dotfiles-daily
  doctor_agent_loaded com.sogamoso.agents-update
  [[ -r ${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/uidotsh.env ]] &&
    doctor_agent_loaded com.sogamoso.uidotsh-token
  local label
  for label in com.sogamoso.workhours.caffeinate-watch com.sogamoso.workhours.caffeinate-run com.sogamoso.workhours.sleep-if-idle; do
    if (( desktop )); then
      doctor_agent_disabled "$label"
    elif [[ $label == *caffeinate-run ]]; then
      # The watcher starts and kills this one, so any exit status is normal
      doctor_agent_loaded "$label" any
    else
      doctor_agent_loaded "$label"
    fi
  done

  echo "==> Skills"
  local dir skill target
  for dir in "$HOME/.claude/skills" "$HOME/.codex/skills"; do
    [[ -d $(dirname "$dir") ]] || continue
    for skill in ui brand-kit markup-from-image; do
      target=$(readlink "$dir/$skill" 2>/dev/null || true)
      if [[ -z $target || ! -e $dir/$skill/SKILL.md ]]; then
        bad "${dir/#$HOME/~}/$skill is missing or broken" "dotfiles reload"
      elif [[ $target == */local/* ]]; then
        ok "${dir/#$HOME/~}/$skill → archived copy (ui.sh refused the token)"
      else
        ok "${dir/#$HOME/~}/$skill → live ui.sh stub"
      fi
    done
  done

  echo "==> Stow"
  # A file added to a package stays unlinked until the next stow, and whatever
  # sources it fails quietly in the meantime
  source "$DOTFILES/install/lib/stow-packages.sh"
  local pkg out missing
  for pkg in "${STOW_PACKAGES[@]}"; do
    if ! out=$(cd "$DOTFILES/stow" && stow --simulate --verbose --no-folding --target "$HOME" "$pkg" 2>&1); then
      bad "$pkg has conflicts: $(sed -n 's/^  \* //p' <<<"$out" | head -1)" "dotfiles stow"
      continue
    fi
    missing=$(sed -n 's/^LINK: \([^ ]*\) => .*/\1/p' <<<"$out")
    if [[ -n $missing ]]; then
      bad "$pkg has $(wc -l <<<"$missing" | tr -d ' ') unlinked file(s): $(head -3 <<<"$missing" | paste -sd ' ' -)" "dotfiles stow"
    else
      ok "$pkg stowed"
    fi
  done

  echo "==> 1Password"
  # With this off, closing the window quits 1Password and the next launch asks
  # for the password again; it has already switched itself off once
  local op_settings="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/Library/Application Support/1Password/Data/settings/settings.json"
  # macOS keeps other apps' data from background jobs, so the daily agent's run
  # can't read the file at all; that's not the setting being off
  local keep_in_tray
  keep_in_tray=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("app.keepInTray"))' "$op_settings" 2>/dev/null) ||
    keep_in_tray="unreadable"
  if [[ ! -e $op_settings ]]; then
    bad "1Password has no settings yet" "Open 1Password and sign in"
  elif [[ $keep_in_tray == "unreadable" ]]; then
    ok "Menu bar setting not checked: macOS keeps 1Password's data from this process"
  elif [[ $keep_in_tray == "True" ]]; then
    ok "Kept in the menu bar, so closing its window doesn't quit it"
  else
    bad "Not kept in the menu bar: closing its window quits it" "1Password → Settings → General → Keep 1Password in the menu bar"
  fi

  echo "==> Vicinae"
  # Its GUI rewrites settings.json, so losing the import would drop the repo's
  # config, launcher hotkey included, without any error
  if grep -q '"dotfiles.json"' "$HOME/.config/vicinae/settings.json" 2>/dev/null; then
    ok "settings.json imports dotfiles.json"
  else
    bad "settings.json doesn't import dotfiles.json" "dotfiles vicinae reset"
  fi
  local drift
  if drift=$(python3 "$DOTFILES/install/lib/vicinae.py" status); then
    ok "Settings and extensions match the repo"
  else
    bad "Vicinae differs from the repo:"$'\n'"$drift" "dotfiles vicinae save to keep it, or dotfiles vicinae reset to drop it"
  fi

  echo "==> Homebrew"
  if [[ "$(brew autoupdate status 2>/dev/null)" == *"running"* ]]; then
    ok "brew autoupdate running"
  else
    bad "brew autoupdate isn't running" "dotfiles brew"
  fi

  if (( DOCTOR_FAILED )); then
    echo "==> Problems found; run the → commands above"
    return 1
  fi
  echo "==> All checks passed"
}

cmd_omarchy() {
  source "$DOTFILES/install/lib/omarchy-candidates.sh"
  case "${1:-}" in
    --list)          cmd_omarchy_list ;;
    --mark-reviewed) cmd_omarchy_mark_reviewed ;;
    "")              cmd_omarchy_review ;;
    *)               echo "Unknown option: $1" >&2; usage >&2; exit 64 ;;
  esac
}

cmd_vicinae() {
  case "${1:-status}" in
    status|save|reset) python3 "$DOTFILES/install/lib/vicinae.py" "${1:-status}" ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 64 ;;
  esac
}

# The default coding agent, mirroring `omarchy default agent` and omarchy-agent:
# the same names, and each agent started with the same unattended flags. Omarchy's
# per-agent accounts aren't ported. Devin and Kiro are left out until mise can
# install them on macOS (see the gaps in docs/macos-manual-setup.md).
AGENT_FILE="$HOME/.config/dotfiles/defaults/agent"

agent_name() {
  case "$1" in
    pi) echo pi ;;
    omp|oh-my-pi) echo omp ;;
    opencode|open-code) echo opencode ;;
    ori|openrouter) echo ori ;;
    claude|claude-code) echo claude ;;
    codex) echo codex ;;
    crush) echo crush ;;
    grok) echo grok ;;
    agy|antigravity|antigravity-cli|gemini|gemini-cli) echo agy ;;
    copilot|github-copilot) echo copilot ;;
    muse|muse-code|musecode) echo muse ;;
    cursor|cursor-agent) echo cursor-agent ;;
    kimi|kimi-code) echo kimi ;;
    qwen|qwen-code) echo qwen ;;
    dsh|deepseek|deepseek-harness) echo dsh ;;
    mcode|minimax-code|minimax) echo mcode ;;
    freebuff) echo freebuff ;;
    kilo|kilocode|kilo-code) echo kilo ;;
    amp|ampcode) echo amp ;;
    commandcode|command-code|cmdc) echo commandcode ;;
    *) return 1 ;;
  esac
}

agent_run() {
  local agent prompt="" clipboard=false
  local -a command

  [[ ${1:-} == "--prompt" ]] && prompt=${2:?--prompt needs a value}
  [[ -f $AGENT_FILE ]] && read -r agent <"$AGENT_FILE"
  if [[ -z ${agent:-} ]]; then
    echo "Choose a default agent with: dotfiles agent <name>" >&2
    exit 1
  fi

  case "$agent" in
    opencode) command=(opencode --auto); [[ -n $prompt ]] && command+=(--prompt "$prompt") ;;
    agy) command=(agy --dangerously-skip-permissions); [[ -n $prompt ]] && command+=(--prompt-interactive "$prompt") ;;
    copilot) command=(copilot --allow-all); [[ -n $prompt ]] && command+=(--interactive "$prompt") ;;
    crush) if [[ -n $prompt ]]; then command=(crush run "$prompt"); else command=(crush --yolo); fi ;;
    claude) command=(claude --permission-mode auto); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    grok) command=(grok --permission-mode bypassPermissions); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    codex) command=(codex --approve-for-me); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    cursor-agent) command=(cursor-agent --yolo --trust); [[ -n $prompt ]] && command+=(agent -- "$prompt") ;;
    muse) command=(muse --approval-mode never); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    omp) command=(omp --auto-approve); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    ori) command=(ori code); [[ -n $prompt ]] && command+=(--interactive --prompt "$prompt") ;;
    pi) command=(pi); [[ -n $prompt ]] && command+=("$prompt") ;;
    kimi) if [[ -n $prompt ]]; then command=(kimi --prompt "$prompt"); else command=(kimi --yolo); fi ;;
    qwen) command=(qwen --yolo); [[ -n $prompt ]] && command+=("--prompt-interactive=$prompt") ;;
    dsh) command=(env DSH_PERMISSION_MODE=danger-full-access dsh web); clipboard=true ;;
    mcode) command=(mcode); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    freebuff) command=(freebuff); clipboard=true ;;
    kilo) command=(kilo --auto); [[ -n $prompt ]] && command+=("--prompt=$prompt") ;;
    amp)
      # Amp takes its first message from piped input; a positional one exits after a turn
      if [[ -n $prompt ]]; then
        command=(bash -c 'printf "%s\n" "$1" | exec amp --dangerously-allow-all' amp "$prompt")
      else
        command=(amp --dangerously-allow-all)
      fi
      ;;
    commandcode) command=(commandcode --yolo); [[ -n $prompt ]] && command+=(-- "$prompt") ;;
    *) echo "Unsupported default agent: $agent" >&2; exit 1 ;;
  esac

  # Agents with no starting prompt get it on the clipboard instead, as Omarchy does
  if $clipboard && [[ -n $prompt ]]; then
    printf '%s' "$prompt" | pbcopy
    echo "The task is on the clipboard; paste it into $agent."
  fi

  exec "${command[@]}"
}

cmd_agent() {
  local agent
  case "${1:-}" in
    "")
      [[ -f $AGENT_FILE ]] && read -r agent <"$AGENT_FILE" && echo "$agent"
      return 0
      ;;
    run) shift; agent_run "$@" ;;
    *)
      if ! agent=$(agent_name "$1"); then
        echo "Unknown agent: $1" >&2
        exit 64
      fi
      if ! command -v "$agent" >/dev/null; then
        echo "$agent isn't installed: it isn't in the Brewfile or the mise agents" >&2
        exit 1
      fi
      mkdir -p "$(dirname "$AGENT_FILE")"
      echo "$agent" >"$AGENT_FILE"
      echo "Default agent: $agent"
      ;;
  esac
}

cmd_edit() {
  ${VISUAL:-nvim} "$DOTFILES"
}

case "${1:-help}" in
  update)         cmd_update ;;
  pull)           cmd_pull ;;
  brew)           cmd_brew ;;
  stow)           cmd_stow ;;
  reload)         cmd_reload ;;
  status)         cmd_status ;;
  doctor)         cmd_doctor ;;
  vicinae)        shift; cmd_vicinae "$@" ;;
  omarchy-downstream-candidates) shift; cmd_omarchy "$@" ;;
  agent)          shift; cmd_agent "$@" ;;
  edit)           cmd_edit ;;
  help|-h|--help) usage ;;
  *)              echo "Unknown command: $1" >&2; usage >&2; exit 64 ;;
esac

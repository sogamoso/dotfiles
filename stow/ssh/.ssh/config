# Hosts bookmarked in 1Password (Developer → SSH Agent → Advanced → Generate SSH
# config file with bookmarked hosts). First, so its Match applies before the
# blocks below; a missing file, as on Omarchy without 1Password, is skipped.
Include ~/.ssh/1Password/config

# macOS only: 1Password's agent socket. Missing on Omarchy, so skipped there.
Include ~/.ssh/config.macos

Host *
  IdentitiesOnly yes

  # Surface a dropped link in ~45s (3 missed probes at 15s) instead of waiting
  # out TCP. Without this a remote tmux/herdr session can hang for minutes and
  # leave the local terminal in the alternate screen with mouse tracking armed.
  ServerAliveInterval 15
  ServerAliveCountMax 3

Host github.com
  HostName github.com
  User git

# Tailscale SSH: the tailnet authenticates, so no key is offered. Names match
# the hosts set up in Blink on the phone; mosh reads them too.
Host mac-mini
  HostName sogamoso-m4-mac-mini
  User sogamoso

Host macbook
  HostName sogamoso-m5-pro-macbook
  User sogamoso

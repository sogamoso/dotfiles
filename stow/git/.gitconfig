[user]
  name = Sebastian Sogamoso
  email = sebastian@sogamo.so
  signingkey = ~/.ssh/id_ed25519_git_signing.pub

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgSign = true

[alias]
  sw = switch

[init]
  defaultBranch = main

[include]
  path = ~/.config/git/config.macos
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

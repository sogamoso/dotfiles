#!/usr/bin/env bash
set -euo pipefail

# Adds the agent keys from layouts.bash, the key for the worktree plugin and the
# pull request status to herdr's config. On Omarchy that file is Omarchy's to
# ship, and an update migration can replace it through omarchy-refresh-herdr, so
# Omarchy runs this after every update and the Linux install runs it once. The
# keys match the macOS herdr config; keep the two in sync.

config="$HOME/.config/herdr/config.toml"
marker="# dotfiles: agent keys"

[[ -f $config ]] || exit 0
changed=false

# Alt+1..9 jumps to agents, as Cmd+1..9 does on macOS, and tabs keep prefix+1..9.
# Both lines sit inside Omarchy's [keys], so its switch_tab line is rewritten in
# place; if Omarchy changes that line, this says so rather than guessing.
omarchy_switch_tab='switch_tab = ["prefix+1..9", "alt+1..9"]'
if ! grep -q '^focus_agent = ' "$config"; then
  if grep -qxF "$omarchy_switch_tab" "$config"; then
    tmp=$(mktemp)
    awk -v line="$omarchy_switch_tab" '
      $0 == line { print "switch_tab = \"prefix+1..9\""; print "focus_agent = \"alt+1..9\""; next }
      { print }
    ' "$config" >"$tmp"
    cat "$tmp" >"$config"
    rm -f "$tmp"
    changed=true
  else
    echo "herdr-agent-keys: Omarchy's switch_tab line changed; Alt+1..9 still switches tabs" >&2
  fi
fi

if ! grep -qxF "$marker" "$config"; then
  cat >>"$config" <<'KEYS'

# dotfiles: agent keys
[[keys.command]]
key = "prefix+a"
type = "popup"
command = "\"$SHELL\" -ic 'cd \"$HERDR_ACTIVE_PANE_CWD\" && hrw || read -rsn1 -p \"Press any key to close\"'"
description = "new agent on its own worktree (hrw)"

[[keys.command]]
key = "prefix+shift+a"
type = "popup"
command = "\"$SHELL\" -ic 'cd \"$HERDR_ACTIVE_PANE_CWD\" && hra || read -rsn1 -p \"Press any key to close\"'"
description = "new agent on a task (hra)"

[[keys.command]]
key = "prefix+f"
type = "popup"
command = "\"$SHELL\" -ic 'hrd || read -rsn1 -p \"Press any key to close\"'"
description = "finish agent, removing its worktree and branch (hrd)"
KEYS
  changed=true
fi

# The popups used to wait on a whole line, so only Enter or Ctrl+C closed one.
# Keys added before that wait on one key now, Esc included.
old_wait="|| read -r _'"
new_wait='|| read -rsn1 -p \"Press any key to close\"'"'"
if grep -qF "$old_wait" "$config"; then
  tmp=$(mktemp)
  # Through the environment, as below: awk -v would eat the backslashes
  old="$old_wait" new="$new_wait" awk '
    { while ((i = index($0, ENVIRON["old"])) > 0)
        $0 = substr($0, 1, i - 1) ENVIRON["new"] substr($0, i + length(ENVIRON["old"])) }
    { print }
  ' "$config" >"$tmp"
  cat "$tmp" >"$config"
  rm -f "$tmp"
  changed=true
fi

# Its own marker, so a config that already has the agent keys still gets it
plugin_marker="# dotfiles: worktree plugin keys"
if ! grep -qxF "$plugin_marker" "$config"; then
  cat >>"$config" <<'KEYS'

# dotfiles: worktree plugin keys
[[keys.command]]
key = "prefix+u"
type = "plugin_action"
command = "worktree.create"
description = "worktree from a pull request, issue or branch"
KEYS
  changed=true
fi

# Pull request status, as on macOS. The status script runs from the tab bar's
# status area, which prints nothing and so acts as its timer. Omarchy's [ui]
# already sets tab_bar_right, so the command joins its line in place, as
# switch_tab does above.
pr_status='{ type = "command", command = "\"$HOME/.config/herdr/scripts/pr-status.sh\"", interval_seconds = 30, timeout_seconds = 20 }'
omarchy_tab_bar_right='tab_bar_right = [{ type = "zoom" }, { type = "hostname" }]'
if ! grep -qF 'pr-status.sh' "$config"; then
  if grep -qxF "$omarchy_tab_bar_right" "$config"; then
    tmp=$(mktemp)
    # Through the environment: awk -v would eat the entry's backslashes
    line="$omarchy_tab_bar_right" entry="$pr_status" awk '
      $0 == ENVIRON["line"] { print "tab_bar_right = [{ type = \"zoom\" }, { type = \"hostname\" }, " ENVIRON["entry"] "]"; next }
      { print }
    ' "$config" >"$tmp"
    cat "$tmp" >"$config"
    rm -f "$tmp"
    changed=true
  else
    echo "herdr-agent-keys: Omarchy's tab_bar_right line changed; the pull request status won't run" >&2
  fi
fi

# The status used to be a row on every workspace; now it's rows on the agent
# whose session opened the pull request, with its link. Only this hook writes
# sidebar rows into Omarchy's config, so the old block's lines are rewritten.
pr_marker="# dotfiles: pull request status"
if grep -qxF '[ui.sidebar.spaces]' "$config"; then
  tmp=$(mktemp)
  awk '
    $0 == "[ui.sidebar.spaces]" { print "[ui.sidebar.agents]"; block = 1; next }
    block && $0 == "  [\"state_icon\", \"workspace\"]," { print "  [\"state_icon\", \"machine\", \"workspace\", \"tab\"],"; next }
    block && $0 == "  [\"branch\", \"git_status\"]," { print "  [\"$repo\", \"agent\"],"; next }
    block && index($0, "token = \"$pr\"") { print; print "  [\"$pr_url\"],"; next }
    block && $0 == "]" { block = 0 }
    { print }
  ' "$config" >"$tmp"
  cat "$tmp" >"$config"
  rm -f "$tmp"
  changed=true
fi

if ! grep -qxF "$pr_marker" "$config"; then
  cat >>"$config" <<'KEYS'

# dotfiles: pull request status
[ui.sidebar.agents]
rows = [
  ["state_icon", "machine", "workspace", "tab"],
  ["$repo", "agent"],
  [{ token = "$pr", rules = [{ contains = "blocked", fg = "#f7768e", bold = true }, { contains = "running", fg = "#ff9e64" }, { contains = "passed", fg = "#9ece6a" }] }],
  ["$pr_url"],
]

[[keys.command]]
key = "prefix+shift+u"
type = "popup"
command = "\"$HOME/.config/herdr/scripts/pr-open.sh\""
description = "open this branch's pull request in terminal-browser"
width = "90%"
height = "90%"
KEYS
  changed=true
fi

# Its own marker, so configs that already have the status get it
browser_marker="# dotfiles: pull request in the browser"
if ! grep -qxF "$browser_marker" "$config"; then
  cat >>"$config" <<'KEYS'

# dotfiles: pull request in the browser
[[keys.command]]
key = "prefix+shift+b"
type = "popup"
command = "\"$HOME/.config/herdr/scripts/pr-open.sh\" --browser"
description = "open this branch's pull request in the browser"
KEYS
  changed=true
fi

# The agent row used to carry only the agent's name; now the repo a worktree
# session belongs to goes in front of it
old_agent_row='  ["agent"],'
new_agent_row='  ["$repo", "agent"],'
if grep -qxF "$old_agent_row" "$config"; then
  tmp=$(mktemp)
  old="$old_agent_row" new="$new_agent_row" awk '
    $0 == ENVIRON["old"] { print ENVIRON["new"]; next }
    { print }
  ' "$config" >"$tmp"
  cat "$tmp" >"$config"
  rm -f "$tmp"
  changed=true
fi

# The colour rules used to check passed first; now the worst status wins, so a
# branch with several pull requests shows the one that needs attention
old_rules='  [{ token = "$pr", rules = [{ contains = "passed", fg = "#9ece6a" }, { contains = "running", fg = "#ff9e64" }, { contains = "blocked", fg = "#f7768e", bold = true }] }],'
new_rules='  [{ token = "$pr", rules = [{ contains = "blocked", fg = "#f7768e", bold = true }, { contains = "running", fg = "#ff9e64" }, { contains = "passed", fg = "#9ece6a" }] }],'
if grep -qxF "$old_rules" "$config"; then
  tmp=$(mktemp)
  old="$old_rules" new="$new_rules" awk '
    $0 == ENVIRON["old"] { print ENVIRON["new"]; next }
    { print }
  ' "$config" >"$tmp"
  cat "$tmp" >"$config"
  rm -f "$tmp"
  changed=true
fi

if $changed && command -v herdr >/dev/null; then
  herdr server reload-config >/dev/null 2>&1 || true
fi
